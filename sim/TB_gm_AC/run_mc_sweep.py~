import os
import glob
import subprocess
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# ==============================================================================
# 1. NGSPICE RAW PARSER (From cicsim)
# ==============================================================================
BSIZE_SP = 512
MDATA_LIST =[b'title', b'date', b'plotname', b'flags', b'no. variables',
              b'no. points', b'dimensions', b'command', b'option']

def ngRawRead(fname: str):
    fp = open(fname, 'rb')
    plot = {}
    arrs =[]
    plots =[]
    names = dict()
    ind = 0
    while (True):
        try:
            mdata = fp.readline(BSIZE_SP).split(b':', maxsplit=1)
        except:
            raise
        if len(mdata) == 2:
            if mdata[0].lower() in MDATA_LIST:
                plot[mdata[0].lower()] = mdata[1].strip()
            if mdata[0].lower() == b'variables':
                nvars = int(plot[b'no. variables'])
                npoints = int(plot[b'no. points'])
                plot['varnames'] = []
                plot['varunits'] =[]
                for varn in range(nvars):
                    varspec = (fp.readline(BSIZE_SP).strip().decode('ascii').split())
                    assert(varn == int(varspec[0]))
                    if(varspec[1] not in names):
                        names[varspec[1]] = 1
                    else:
                        varspec[1] += str(ind)
                        ind +=1
                    plot['varnames'].append(varspec[1])
                    plot['varunits'].append(varspec[2])
            if mdata[0].lower() == b'binary':
                rowdtype = np.dtype({'names': plot['varnames'],
                                     'formats':[np.complex128 if b'complex'
                                                 in plot[b'flags']
                                                 else np.float64]*nvars})
                arrs.append(np.fromfile(fp, dtype=rowdtype, count=npoints))
                plots.append(plot)
                fp.readline() 
        else:
            break
    fp.close()
    return (arrs, plots)

def toDataFrames(ngarr):
    (arrs, plots) = ngarr
    dfs = list()
    for i in range(0, len(plots)):
        df = pd.DataFrame(data=arrs[i], columns=plots[i]['varnames'])
        dfs.append(df)
    return dfs


# ==============================================================================
# 2. USER CONFIGURATION
# ==============================================================================
RUN_SIMULATION = False

# The exact terminal command you use to trigger the Monte Carlo sweep.
# E.g., ["make", "mc"] or ["cicsim", "run", "ac", "mc"]
SIM_COMMAND =["make", "mc"]

# ==============================================================================
# 3. EXECUTION LOOP
# ==============================================================================
if RUN_SIMULATION:
    os.makedirs("output_ac", exist_ok=True)
    
    # Load parameters, ignoring spaces after commas
    sizes = pd.read_csv("vdd_gm_sweep_sizes.csv", skipinitialspace=True)
    sizes.columns = sizes.columns.str.replace('"', '') 
    
    vdd_list = []
    gm_mean_list =[]
    gm_std_list =[]

    print(f"Starting Monte Carlo Sweep ({len(sizes)} designs)...")
    for row in sizes.itertuples(index=False):
        VDD = row.VDD
        m_alpha = int(row.P0)
        m_beta = int(row.N1)
        m_gamma = int(row.N2)

        # 1. Write the parameters
        with open("output_ac/sweep_sizes.spi", "w") as f:
            f.write(f"* Autogenerated by Grid Search\n")
            f.write(f".param AVDD = {VDD}\n")
            f.write(f".param m_alpha = {m_alpha}\n")
            f.write(f".param m_beta = {m_beta}\n")
            f.write(f".param m_gamma = {m_gamma}\n")

        # 2. Clean up ANY old .raw files so we don't mix up runs
        old_raw_files = glob.glob("output_ac/*.raw")
        for old_file in old_raw_files:
            os.remove(old_file)

        # 3. Run the Monte Carlo Simulation
        print(f"Running MC for VDD = {VDD:.3f}V ...", end="", flush=True)
        subprocess.run(SIM_COMMAND)

        # 4. Find all newly generated .raw files
        new_raw_files = glob.glob("output_ac/*.raw")

        if not new_raw_files:
            print(" Error: No .raw files were generated!")
            continue

        gm_iterations =[]
        
        # 5. Extract data robustly (handles 1 giant raw file OR 30 split raw files)
        for raw_file in new_raw_files:
            try:
                arrs, plots = ngRawRead(raw_file)
                dfs = toDataFrames((arrs, plots))
                
                # Some raw files have multiple Monte Carlo plots inside them
                for df in dfs:
                    ivout_col = next(col for col in df.columns if 'i(vout)' in col.lower())
                    
                    # Extract last frequency point, isolate Real part, invert sign
                    i_vout_32k = df[ivout_col].iloc[-1]
                    gm_val = -np.real(i_vout_32k)
                    gm_iterations.append(gm_val)
            except Exception as e:
                print(f" (Error parsing {raw_file}: {e})", end="")

        if not gm_iterations:
            print(" Error: Failed to extract gm data from raw files.")
            continue

        # 6. Calculate statistics
        gm_mean = np.mean(gm_iterations)
        gm_std = np.std(gm_iterations)
        
        vdd_list.append(VDD)
        gm_mean_list.append(gm_mean)
        gm_std_list.append(gm_std)
        
        print(f" Done! Extracted {len(gm_iterations)} runs. Mean gm: {gm_mean:.3e} S, Std: {gm_std:.3e} S")

    # Save summary data so you can tweak the plot later without re-simulating!
    df_summary = pd.DataFrame({'VDD': vdd_list, 'gm_mean': gm_mean_list, 'gm_std': gm_std_list})
    df_summary.to_csv("mc_summary_results.csv", index=False)
    print("\nSimulation sweep complete. Data saved to mc_summary_results.csv")

else:
    # If RUN_SIMULATION = False, just load the existing summary
    if not os.path.exists("mc_summary_results.csv"):
        print("Error: mc_summary_results.csv not found. Set RUN_SIMULATION = True first.")
        exit()
        
    df_summary = pd.read_csv("mc_summary_results.csv")
    vdd_list = df_summary['VDD'].values
    gm_mean_list = df_summary['gm_mean'].values
    gm_std_list = df_summary['gm_std'].values


# ==============================================================================
# 4. PLOTTING THE MONTE CARLO RESULTS
# ==============================================================================
vdd_arr = np.array(vdd_list)
mean_arr = np.array(gm_mean_list)
std_arr = np.array(gm_std_list)

fig, ax = plt.subplots(figsize=(10, 6))

# Plot the mean line
ax.plot(vdd_arr, mean_arr, color='black', marker='o', linestyle='-', linewidth=2, label='Mean $g_m$')

# Plot the +/- 1 Standard Deviation shaded region
ax.fill_between(vdd_arr, 
                mean_arr - std_arr, 
                mean_arr + std_arr, 
                color='blue', alpha=0.3, label=r'$\pm 1 \sigma$ (Standard Deviation)')

# Formatting the plot
ax.set_title('Monte Carlo Transconductance ($g_m$) vs. VDD', fontsize=14)
ax.set_xlabel('VDD [Volts]', fontsize=12)
ax.set_ylabel('Transconductance ($g_m$) [S]', fontsize=12)

# Make axes use scientific notation cleanly
ax.ticklabel_format(style='sci', axis='y', scilimits=(0,0))
ax.grid(True, which='both', linestyle='--', alpha=0.6)
ax.legend(loc='upper left', fontsize=12)

plt.tight_layout()
plt.show()
